rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOf(spaceId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
    }

    function isValidName(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isValidOptionalString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function missingOrString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    function isValidCreatedAt(value) {
      return value is timestamp || value is number;
    }

    function isValidRepeat(value) {
      return value == null
        || (value is map
            && value.keys().hasOnly(['freq'])
            && value.freq in ['daily', 'weekly', 'monthly']);
    }

    function isValidRotation(value) {
      return value == null
        || (value is map
            && value.keys().hasOnly(['members'])
            && value.members is list
            && value.members.size() >= 2);
    }

    // The slice of you that lives on a space: what the others need to paint your light and
    // ring your phone, and nothing else. Your account itself stays yours alone.
    function isValidMemberProfile(profile) {
      return profile is map
        && profile.keys().hasOnly(['name', 'expoPushToken'])
        && isValidName(profile.name, 20)
        && missingOrString(profile, 'expoPushToken', 220);
    }

    // Every write to `members` may only touch your own entry. Nobody edits anyone else's
    // name or token — not even to help.
    function touchesOnlyOwnMemberEntry() {
      return request.resource.data.members.diff(resource.data.members)
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    /**
     * Your account. Only yours.
     *
     * It used to be readable by the person sharing a space with you, because their phone
     * needed your name and push token. Those now travel on the space itself (`members`),
     * so there is no reason left for anyone else to open this document — and your email
     * stops being visible to every space you ever share.
     */
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'createdAt',
          'expoPushToken'
        ])
        && missingOrString(request.resource.data, 'email', 320)
        && isValidName(request.resource.data.displayName, 20)
        && isValidCreatedAt(request.resource.data.createdAt);
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'expoPushToken'
        ])
        && isValidName(request.resource.data.displayName, 20)
        && missingOrString(request.resource.data, 'expoPushToken', 220);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    /**
     * A key on its own, so that using one means *knowing* it.
     *
     * There is no list: you can only open the door whose code you already have. The code
     * now outlives the first guest — it works until the space fills up or a member takes
     * it down — because a space is no longer a thing that seats exactly two.
     */
    match /invites/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['spaceId', 'createdAt'])
        && isMemberOf(request.resource.data.spaceId)
        && get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.kind == 'shared'
        && isValidCreatedAt(request.resource.data.createdAt);
      allow delete: if isSignedIn() && isMemberOf(resource.data.spaceId);
    }

    /**
     * A space: a small circle of 1 to 8 people. The order of `memberIds` is the order of
     * arrival, and the order of arrival is the colour each person wears — so that list is
     * append-only for joins and remove-only for leaves, never reshuffled.
     *
     * `kind` separates the space you always have ('personal', just you, no door) from the
     * ones you open to others ('shared').
     */
    match /spaces/{spaceId} {
      // No list by id: spaces are found by being in them (the membership query), never browsed.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'kind',
          'name',
          'memberIds',
          'members',
          'inviteCode',
          'palette',
          'createdAt'
        ])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && isValidMemberProfile(request.resource.data.members[request.auth.uid])
        && isValidName(request.resource.data.name, 28)
        && isValidCreatedAt(request.resource.data.createdAt)
        && (
          // The personal space is deterministic — one per account, no door, no key. Its id
          // being derived from the uid is what makes creating it idempotent and race-free.
          (request.resource.data.kind == 'personal'
            && spaceId == 'personal_' + request.auth.uid
            && request.resource.data.inviteCode == null)
          || (request.resource.data.kind == 'shared'
            && request.resource.data.inviteCode.matches('^[A-Z0-9]{6}$'))
        );

      allow update: if isSignedIn()
        && (
          // A member changing what belongs to the space (name, palette) or the one entry
          // in `members` that belongs to them.
          (request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'palette', 'members'])
            && isValidName(request.resource.data.name, 28)
            && (!('palette' in request.resource.data)
                || request.resource.data.palette in ['neon', 'brasa', 'selva', 'cobalto', 'coral', 'lima'])
            && (!('members' in request.resource.data.diff(resource.data).affectedKeys())
                || (touchesOnlyOwnMemberEntry()
                    && isValidMemberProfile(request.resource.data.members[request.auth.uid]))))

          // Someone holding the key walking in: the one moment a non-member may write, and
          // only to append themselves — to the list and to `members`, nothing else.
          || (resource.data.kind == 'shared'
            && !(request.auth.uid in resource.data.memberIds)
            && resource.data.memberIds.size() < 8
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
            && touchesOnlyOwnMemberEntry()
            && isValidMemberProfile(request.resource.data.members[request.auth.uid]))

          // A member walking out while others stay: they remove exactly themselves. The
          // last one out doesn't pass through here — they delete the space instead.
          || (request.auth.uid in resource.data.memberIds
            && resource.data.memberIds.size() > 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && touchesOnlyOwnMemberEntry())
        );

      // Only the last person in can take the space down — for everyone else, leaving is an
      // update. So content never disappears under someone still living in it.
      allow delete: if isSignedIn() && resource.data.memberIds == [request.auth.uid];

      match /reminders/{reminderId} {
        allow read: if isMemberOf(spaceId);
        allow create: if isMemberOf(spaceId)
          && request.resource.data.keys().hasOnly([
            'title',
            'dueAt',
            'dueLabel',
            'status',
            'createdByUid',
            'targetUids',
            'repeat',
            'rotation',
            'createdAt'
          ])
          && isValidName(request.resource.data.title, 120)
          && isValidOptionalString(request.resource.data.dueLabel, 80)
          && (request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdByUid == request.auth.uid
          // Every phone a reminder is meant to ring on must belong to someone in the space.
          // The client writes the concrete list ("everyone" arrives already expanded).
          && request.resource.data.targetUids is list
          && request.resource.data.targetUids.size() >= 1
          && get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds
            .hasAll(request.resource.data.targetUids)
          && (!('repeat' in request.resource.data) || isValidRepeat(request.resource.data.repeat))
          && (!('rotation' in request.resource.data) || isValidRotation(request.resource.data.rotation))
          // Rotation starts on its first name: the cast is a promise about every future
          // turn, but the turn ringing right now is still just one person, like any other.
          && (!('rotation' in request.resource.data) || request.resource.data.rotation == null
              || (get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds
                    .hasAll(request.resource.data.rotation.members)
                  && request.resource.data.targetUids == [request.resource.data.rotation.members[0]]))
          && isValidCreatedAt(request.resource.data.createdAt);
        allow update: if isMemberOf(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dueAt',
            'dueLabel',
            'status',
            'completedAt',
            'targetUids'
          ])
          && (request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp)
          && isValidOptionalString(request.resource.data.dueLabel, 80)
          && request.resource.data.status in ['pending', 'done']
          // Handing a turn to the next person — or reassigning outright — same shape as
          // creating one: a non-empty list of people who actually live in this space.
          && (!('targetUids' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.targetUids is list
                  && request.resource.data.targetUids.size() >= 1
                  && get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds
                    .hasAll(request.resource.data.targetUids)))
          && (!('completedAt' in request.resource.data)
              || request.resource.data.completedAt == null
              || request.resource.data.completedAt is timestamp);
        allow delete: if isMemberOf(spaceId);
      }

      match /photos/{photoId} {
        allow read: if isMemberOf(spaceId);
        allow create: if isMemberOf(spaceId)
          && request.resource.data.keys().hasOnly([
            'imageUrl',
            'cloudinaryPublicId',
            'uploadedByUid',
            'createdAt',
            'reactions'
          ])
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 2000
          && request.resource.data.cloudinaryPublicId is string
          && request.resource.data.cloudinaryPublicId.size() <= 300
          && request.resource.data.uploadedByUid == request.auth.uid
          && isValidCreatedAt(request.resource.data.createdAt);
        // Pinning, like on the Tablón, is a soft house rule the client keeps to two — not
        // something worth an aggregate query in the rules to enforce.
        allow update: if isMemberOf(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned'])
          && (!('pinned' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.pinned is bool);
        allow delete: if isMemberOf(spaceId);
      }

      // The Tablón — the door-of-the-fridge note board. Its collection is still named
      // `messages` (that predates the pivot and nobody outside this file ever sees it);
      // what changed is the shape: notes can be pinned, and the client, not the rules,
      // keeps the pinned count to two — that's a soft house rule, not a security boundary.
      match /messages/{messageId} {
        allow read: if isMemberOf(spaceId);
        allow create: if isMemberOf(spaceId)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt'])
          && isValidName(request.resource.data.text, 500)
          && request.resource.data.senderId == request.auth.uid
          && isValidCreatedAt(request.resource.data.createdAt);
        allow update: if isMemberOf(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned'])
          && (!('pinned' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.pinned is bool);
        allow delete: if isMemberOf(spaceId);
      }
    }
  }
}
