{
  "name": "flare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @flare/mobile",
    "dev:web": "npm run dev --workspace @flare/web",
    "android": "npm run android --workspace @flare/mobile",
    "build:web": "npm run build --workspace @flare/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "functions:check": "npm --prefix functions run check"
  },
  "devDependencies": {
    "firebase-admin": "^14.2.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
